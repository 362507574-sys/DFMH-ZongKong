{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-control-center/contracts/ai-deal-officer/deal-evidence-ledger.schema.json",
  "title": "AI成交官证据账本",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "identity", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "identity": { "$ref": "#/$defs/identity" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,119}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enterpriseId", "businessProjectId", "taskId", "customerRef"],
      "properties": {
        "enterpriseId": { "$ref": "#/$defs/safeId" },
        "businessProjectId": { "$ref": "#/$defs/safeId" },
        "taskId": { "$ref": "#/$defs/safeId" },
        "customerRef": { "$ref": "#/$defs/safeId" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "enterpriseId",
        "businessProjectId",
        "taskId",
        "customerRef",
        "factClass",
        "summary",
        "sourceRef",
        "sha256",
        "createdAt"
      ],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/safeId" },
        "enterpriseId": { "$ref": "#/$defs/safeId" },
        "businessProjectId": { "$ref": "#/$defs/safeId" },
        "taskId": { "$ref": "#/$defs/safeId" },
        "customerRef": { "$ref": "#/$defs/safeId" },
        "factClass": {
          "enum": [
            "enterprise_fact",
            "customer_statement",
            "behavior_evidence",
            "public_source",
            "ai_inference",
            "hypothesis",
            "unknown"
          ]
        },
        "summary": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
