{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deal-strategy-candidate.schema.json",
  "title": "AI成交策略候选",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilityId",
    "enterpriseId",
    "taskId",
    "version",
    "customerInsightRef",
    "communicationStrategy",
    "valueEvidenceMatrix",
    "objectionHandling",
    "dealPath",
    "followUpPlan",
    "evidenceIndex",
    "unknowns",
    "downstreamBrief",
    "clientAutonomy",
    "externalActions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capabilityId": { "const": "deal-strategy" },
    "enterpriseId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "customerInsightRef": { "type": "object" },
    "communicationStrategy": { "type": "object" },
    "valueEvidenceMatrix": { "type": "array", "minItems": 1 },
    "objectionHandling": { "type": "array", "minItems": 1 },
    "dealPath": { "type": "array", "minItems": 1 },
    "followUpPlan": { "type": "object" },
    "evidenceIndex": { "type": "array", "minItems": 1 },
    "unknowns": { "type": "array" },
    "downstreamBrief": { "type": "object" },
    "clientAutonomy": { "type": "object" },
    "externalActions": { "type": "array", "maxItems": 0 }
  }
}
