{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sales-training-candidate.schema.json",
  "title": "AI销售训练候选",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilityId",
    "enterpriseId",
    "taskId",
    "version",
    "dealStrategyRef",
    "simulationScenario",
    "coachingPlan",
    "scorecard",
    "championReplication",
    "evaluationBoundary",
    "evidenceIndex",
    "unknowns",
    "clientAutonomy",
    "externalActions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capabilityId": { "const": "sales-training" },
    "enterpriseId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "dealStrategyRef": { "type": "object" },
    "simulationScenario": { "type": "object" },
    "coachingPlan": { "type": "object" },
    "scorecard": { "type": "array", "minItems": 1 },
    "championReplication": { "type": "object" },
    "evaluationBoundary": { "type": "object" },
    "evidenceIndex": { "type": "array", "minItems": 1 },
    "unknowns": { "type": "array" },
    "clientAutonomy": { "type": "object" },
    "externalActions": { "type": "array", "maxItems": 0 }
  }
}
