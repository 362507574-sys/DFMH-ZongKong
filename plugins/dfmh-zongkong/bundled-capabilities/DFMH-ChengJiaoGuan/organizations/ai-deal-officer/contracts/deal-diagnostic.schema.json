{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-control-center/contracts/ai-deal-officer/deal-diagnostic.schema.json",
  "title": "AI成交官调试诊断",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "diagnosticId",
    "taskId",
    "planId",
    "planVersion",
    "phase",
    "rootCauseCode",
    "action",
    "retryable",
    "evidenceRefs",
    "affectedStepIds",
    "collaborationOrganizationId",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "diagnosticId": { "type": "string", "minLength": 3 },
    "taskId": { "type": "string", "minLength": 3 },
    "planId": { "type": "string", "minLength": 3 },
    "planVersion": { "type": "integer", "minimum": 1 },
    "phase": {
      "enum": ["before_execution", "during_execution", "after_execution"]
    },
    "rootCauseCode": {
      "enum": [
        "none",
        "context_mismatch",
        "permission_gap",
        "evidence_gap",
        "insight_error",
        "strategy_error",
        "training_error",
        "upstream_drift",
        "cross_org_issue",
        "external_action_blocked",
        "compliance_blocked",
        "temporary_failure"
      ]
    },
    "action": {
      "enum": [
        "continue",
        "repair_current_step",
        "rollback_to_insight",
        "rollback_to_strategy",
        "retrain",
        "request_collaboration",
        "wait_for_input",
        "stop"
      ]
    },
    "retryable": { "type": "boolean" },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "affectedStepIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "collaborationOrganizationId": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
