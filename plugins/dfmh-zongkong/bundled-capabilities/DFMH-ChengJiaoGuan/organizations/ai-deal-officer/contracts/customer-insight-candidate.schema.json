{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "customer-insight-candidate.schema.json",
  "title": "AI客户洞察候选",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilityId",
    "enterpriseId",
    "businessProjectId",
    "taskId",
    "version",
    "customerRef",
    "planRef",
    "projectContextVersion",
    "evidenceLedgerRevision",
    "debugCheckpoints",
    "sourceCustomerRefs",
    "customerProfile",
    "buyingMotivations",
    "dealStage",
    "coreConcerns",
    "fitAssessment",
    "nextBestQuestions",
    "evidenceIndex",
    "unknowns",
    "downstreamBrief",
    "clientAutonomy",
    "externalActions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capabilityId": { "const": "customer-insight" },
    "enterpriseId": { "type": "string", "minLength": 1 },
    "businessProjectId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "customerRef": { "type": "string", "minLength": 1 },
    "planRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "version", "sha256"],
      "properties": {
        "planId": { "type": "string", "minLength": 3 },
        "version": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "projectContextVersion": { "type": "integer", "minimum": 1 },
    "evidenceLedgerRevision": { "type": "integer", "minimum": 1 },
    "debugCheckpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeExecution", "duringExecution", "afterExecution"],
      "properties": {
        "beforeExecution": {
          "type": "string",
          "pattern": "^diagnostics/[a-z0-9-]+\\.json$"
        },
        "duringExecution": {
          "type": "string",
          "pattern": "^diagnostics/[a-z0-9-]+\\.json$"
        },
        "afterExecution": {
          "type": "string",
          "pattern": "^diagnostics/[a-z0-9-]+\\.json$"
        }
      }
    },
    "sourceCustomerRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "customerProfile": { "type": "object" },
    "buyingMotivations": { "type": "array", "minItems": 1 },
    "dealStage": { "type": "object" },
    "coreConcerns": { "type": "array", "minItems": 1 },
    "fitAssessment": { "type": "object" },
    "nextBestQuestions": { "type": "array", "minItems": 1 },
    "evidenceIndex": { "type": "array", "minItems": 1 },
    "unknowns": { "type": "array" },
    "downstreamBrief": { "type": "object" },
    "clientAutonomy": { "type": "object" },
    "externalActions": { "type": "array", "maxItems": 0 }
  }
}
