{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-organization-officer.talent-allocation-candidate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "enterpriseId",
    "version",
    "diagnosis",
    "organizationDesign",
    "staffingPlan",
    "jobProfiles",
    "talentProfiles",
    "recruitmentPackage",
    "personJobMatches",
    "performanceDesign",
    "compensationDesign",
    "adjustmentRecommendations",
    "evidenceIndex",
    "unknowns",
    "risks",
    "decisionsRequired",
    "downstreamBrief",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string"},
    "enterpriseId": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "diagnosis": {"type": "object"},
    "organizationDesign": {"type": "object"},
    "staffingPlan": {"type": "object"},
    "jobProfiles": {"type": "array", "minItems": 1},
    "talentProfiles": {"type": "array", "minItems": 1},
    "recruitmentPackage": {"type": "object"},
    "personJobMatches": {"type": "array"},
    "performanceDesign": {"type": "object"},
    "compensationDesign": {"type": "object"},
    "adjustmentRecommendations": {"type": "array"},
    "evidenceIndex": {"type": "array"},
    "unknowns": {"type": "array"},
    "risks": {"type": "array"},
    "decisionsRequired": {"type": "array"},
    "downstreamBrief": {"type": "object"},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
