{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-organization-officer/talent-development-candidate.schema.json",
  "title": "AI组织官人才培养候选",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "enterpriseId",
    "version",
    "upstreamTalentAsset",
    "developmentDiagnosis",
    "learnerScope",
    "capabilityModel",
    "objectives",
    "modules",
    "supportPlan",
    "assessmentPlan",
    "certification",
    "growthPath",
    "operations",
    "evidenceIndex",
    "unknowns",
    "risks",
    "decisionsRequired",
    "downstreamBrief",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string"},
    "enterpriseId": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "upstreamTalentAsset": {"type": "object"},
    "developmentDiagnosis": {"type": "object"},
    "learnerScope": {"type": "object"},
    "capabilityModel": {"type": "array", "minItems": 1},
    "objectives": {"type": "array", "minItems": 1},
    "modules": {"type": "array", "minItems": 1},
    "supportPlan": {"type": "object"},
    "assessmentPlan": {"type": "object"},
    "certification": {"type": "object"},
    "growthPath": {"type": "object"},
    "operations": {"type": "object"},
    "evidenceIndex": {"type": "array", "minItems": 1},
    "unknowns": {"type": "array"},
    "risks": {"type": "array"},
    "decisionsRequired": {"type": "array", "minItems": 1},
    "downstreamBrief": {"type": "object"},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
