{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-organization-officer.upstream-change-request.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "enterpriseId", "businessProjectId", "taskId", "sourceSkill", "sourceStageId", "targetSkill", "problem", "evidence", "impact", "pausePosition", "currentBinding", "recommendedChange", "status"],
  "properties": {
    "schemaVersion": {"const": 2},
    "enterpriseId": {"type": "string"},
    "businessProjectId": {"type": "string"},
    "taskId": {"type": "string"},
    "sourceSkill": {"type": "string"},
    "sourceStageId": {"type": "string"},
    "targetSkill": {"type": "string"},
    "problem": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1},
    "impact": {"type": "array", "minItems": 1},
    "pausePosition": {"type": "string"},
    "currentBinding": {"type": "object"},
    "recommendedChange": {"type": "array"},
    "status": {"const": "requested_to_control_center"}
  }
}
