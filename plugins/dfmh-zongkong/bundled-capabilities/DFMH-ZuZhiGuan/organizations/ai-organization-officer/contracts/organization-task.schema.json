{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-organization-officer.organization-task.v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "taskId",
    "parentTaskId",
    "idempotencyKey",
    "enterpriseId",
    "primaryOrganization",
    "capabilityId",
    "status",
    "accessEnvelope",
    "knowledgeStatus",
    "candidateVersion",
    "revision",
    "failureCounts",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string", "pattern": "^[0-9]{8}-[0-9]{3}-[a-z0-9-]{3,80}$"},
    "parentTaskId": {"type": "string"},
    "idempotencyKey": {"type": "string"},
    "enterpriseId": {"type": "string"},
    "primaryOrganization": {"const": "ai-organization-officer"},
    "capabilityId": {"enum": ["talent-allocation", "talent-development", "process-replication"]},
    "status": {"type": "string"},
    "accessEnvelope": {"type": "object"},
    "inputRefs": {"type": "array"},
    "knowledgeStatus": {"type": "string"},
    "candidateVersion": {"type": "integer", "minimum": 0},
    "revision": {"type": "integer", "minimum": 1},
    "failureCounts": {"type": "object"},
    "decisionRef": {"type": ["string", "null"]},
    "approvedCandidateSha256": {"type": ["string", "null"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
