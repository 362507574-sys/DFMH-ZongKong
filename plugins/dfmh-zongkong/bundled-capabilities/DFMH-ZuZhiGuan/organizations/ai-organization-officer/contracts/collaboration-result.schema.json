{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-organization-officer.collaboration-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "parentTaskId",
    "requestId",
    "enterpriseId",
    "primaryOrganization",
    "respondingOrganization",
    "requestedCapability",
    "status",
    "artifacts",
    "evidence",
    "assumptions",
    "risks",
    "unresolvedItems",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractVersion": {"const": 1},
    "parentTaskId": {"type": "string"},
    "requestId": {"type": "string"},
    "enterpriseId": {"type": "string"},
    "primaryOrganization": {"const": "ai-organization-officer"},
    "respondingOrganization": {"type": "string"},
    "requestedCapability": {"type": "string"},
    "status": {"enum": ["completed", "partial", "failed"]},
    "artifacts": {"type": "array"},
    "evidence": {"type": "array"},
    "assumptions": {"type": "array"},
    "risks": {"type": "array"},
    "unresolvedItems": {"type": "array"},
    "completedAt": {"type": "string", "format": "date-time"}
  }
}
