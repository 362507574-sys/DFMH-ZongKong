{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-organization-officer.collaboration-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "parentTaskId",
    "requestId",
    "enterpriseId",
    "primaryOrganization",
    "requestingOrganization",
    "targetOrganization",
    "requestedCapability",
    "scope",
    "inputRefs",
    "accessEnvelope",
    "expectedDeliverables",
    "constraints",
    "evidenceRequirements",
    "status",
    "recursionDepth",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractVersion": {"const": 1},
    "parentTaskId": {"type": "string"},
    "requestId": {"type": "string"},
    "enterpriseId": {"type": "string"},
    "primaryOrganization": {"const": "ai-organization-officer"},
    "requestingOrganization": {"const": "ai-organization-officer"},
    "targetOrganization": {"type": "string"},
    "requestedCapability": {"type": "string"},
    "scope": {"type": "string"},
    "inputRefs": {"type": "array"},
    "accessEnvelope": {"type": "object"},
    "expectedDeliverables": {"type": "array"},
    "constraints": {"type": "object"},
    "evidenceRequirements": {"type": "array"},
    "status": {"const": "requested"},
    "recursionDepth": {"const": 1},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
