{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-organization-officer.return-package.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "enterpriseId", "businessProjectId", "taskId", "status", "artifacts", "quality", "decisions", "risks", "limitations", "nextAction", "resumeFrom"],
  "properties": {
    "schemaVersion": {"const": 2},
    "enterpriseId": {"type": "string"},
    "businessProjectId": {"type": "string"},
    "taskId": {"type": "string"},
    "status": {"enum": ["completed", "needs_decision", "needs_collaboration", "needs_input", "blocked", "failed"]},
    "artifacts": {"type": "array"},
    "quality": {"type": "object"},
    "decisions": {"type": "array"},
    "risks": {"type": "array"},
    "limitations": {"type": "array"},
    "nextAction": {"type": "string"},
    "resumeFrom": {"type": ["object", "null"]}
  }
}
